@model AiImageService.Models.ImageAnalysisViewModel

@{
    ViewData["Title"] = "ШІ Розпізнавання Зображень";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center mb-4">
            <h1 class="display-5 fw-bold text-primary mb-3">
                <i class="bi bi-cpu me-2"></i>Класифікація Зображень ШІ
            </h1>
            <p class="lead text-muted">
                Завантажте фото або вкажіть URL-посилання, щоб розпізнати об'єкт за допомогою машинного навчання ML.NET та зберегти результат в AWS.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Index" method="post" enctype="multipart/form-data">

                        <!-- Завантаження файлу -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Оберіть зображення з комп'ютера</label>
                            <input asp-for="File" type="file" class="form-control form-control-lg" id="imageInput" accept="image/*" />
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>

                        <div class="text-center text-muted fw-bold my-3">--- АБО ---</div>

                        <!-- URL посилання -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Вкажіть direct URL посилання на фото</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://example.com/image.jpg" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <!-- Попередній перегляд -->
                        <div id="previewContainer" class="text-center mb-4 d-none">
                            <p class="fw-bold mb-2 text-muted">Попередній перегляд:</p>
                            <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm style-preview" style="max-height: 250px;" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm rounded-3">
                            <i class="bi bi-magic me-2"></i>Проаналізувати та зберегти
                        </button>
                    </form>
                </div>
            </div>

            <!-- Блок з результатом -->
            @if (Model != null && !string.IsNullOrEmpty(Model.PredictedLabel))
            {
                <div class="card shadow-sm border-0 rounded-4 mt-4 bg-light">
                    <div class="card-body p-4">
                        <h4 class="card-title text-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>Результат розпізнавання:</h4>
                        <div class="row align-items-center">
                            @if (!string.IsNullOrEmpty(Model.S3Url))
                            {
                                <div class="col-md-4 text-center mb-3 mb-md-0">
                                    <img src="@Model.S3Url" class="img-fluid rounded-3 shadow-sm" alt="Uploaded" />
                                </div>
                            }
                            <div class="col-md-8">
                                <ul class="list-group list-group-flush rounded-3">
                                    <li class="list-group-item bg-transparent">Класифікація: <strong class="fs-5 text-capitalize text-primary">@Model.PredictedLabel</strong></li>
                                    <li class="list-group-item bg-transparent">Точність (Confidence): <strong>@((Model.Confidence * 100).ToString("F2"))%</strong></li>
                                    <li class="list-group-item bg-transparent">Збережено в S3: <a href="@Model.S3Url" target="_blank" class="text-truncate d-inline-block style-link" style="max-width: 250px;">@Model.S3Url</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const imageInput = document.getElementById('imageInput');
        const previewContainer = document.getElementById('previewContainer');
        const imagePreview = document.getElementById('imagePreview');

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.setAttribute('src', e.target.result);
                    previewContainer.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}